{
	"name": "@quantflow/electron",
	"version": "0.8.0",
	"private": true,
	"license": "FSL-1.1-ALv2",
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"main": "out/main/index.js",
	"scripts": {
		"dev": "bun ./scripts/dev.mjs",
		"build": "node ./scripts/run-local-bin.mjs electron-vite build",
		"preview": "node ./scripts/run-local-bin.mjs electron-vite preview",
		"clean": "bun ./scripts/clean.mjs",
		"clean:deep": "bun ./scripts/clean.mjs --deep",
		"package": "bun ./scripts/package.mjs",
		"generate:icon": "node ./scripts/generate-app-icon.mjs",
		"update-desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/update-desktop.ps1",
		"package:unsigned": "bun ./scripts/package.mjs --no-sign",
		"preflight": "powershell -ExecutionPolicy Bypass -File scripts/check-native-locks.ps1",
		"preflight:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-quantflow-dev.ps1",
		"release": "bun ./scripts/package.mjs --publish",
		"test": "bun test",
		"test:updater": "bun test src/main/updater/github-release-fetcher.test.ts && bun test src/main/updater/downloader.test.ts && bun test src/main/updater/update-manager.test.ts",
		"smoke:herdr-spawn": "bun scripts/herdr-spawn-smoke.ts",
		"smoke:envoy-task": "bun scripts/envoy-task-smoke.ts",
		"smoke:kernel-task": "bun scripts/kernel-task-smoke.ts",
		"smoke:state-card": "bun scripts/state-card-smoke.ts",
		"smoke:conductor": "bun scripts/conductor-smoke.ts",
		"smoke:conductor-actions": "bun scripts/conductor-actions-smoke.ts",
		"smoke:conductor-loop": "bun scripts/conductor-loop-smoke.ts",
		"smoke:workflow-region": "bun scripts/workflow-region-smoke.ts",
		"smoke:vault-export": "bun scripts/vault-export-smoke.ts",
		"smoke:eval": "bun scripts/eval-smoke.ts",
		"smoke:worker-harness": "bun scripts/worker-harness-smoke.ts",
		"smoke:harness-interface": "bun scripts/harness-interface-smoke.ts",
		"smoke:capability-preflight": "bun test src/main/diagnostics/capability-probes.test.ts src/main/diagnostics/preflight.test.ts src/main/credentials/credential-accessor.test.ts",
		"smoke:task-atom": "bun scripts/smoke-task-atom.ts",
		"smoke:dag": "bun scripts/smoke-dag.ts",
		"smoke:context-flow": "bun scripts/smoke-context-flow.ts",
		"smoke:checkpoint": "bun scripts/smoke-checkpoint.ts",
		"smoke:run-template": "bun scripts/smoke-run-template.ts",
		"smoke:judgment": "bun scripts/smoke-judgment.ts",
		"smoke:event-projection": "bun scripts/smoke-event-projection.ts",
		"smoke:perf-trace": "bun scripts/smoke-perf-trace.ts",
		"smoke:authority": "bun scripts/smoke-authority.ts",
		"smoke:pod": "bun scripts/smoke-pod.ts",
		"proof:herdr-ui": "bun scripts/herdr-ui-proof.ts",
		"proof:agentos-loop": "bun scripts/proof-agentos-loop.ts",
		"postinstall": "node scripts/postinstall.mjs"
	},
	"build": {
		"appId": "com.quantflow.desktop",
		"productName": "QuantFlow",
		"icon": "build/icon.png",
		"publish": [
			{
				"provider": "github",
				"owner": "SidNig21",
				"repo": "QuantFlow"
			}
		],
		"directories": {
			"output": "dist"
		},
		"files": [
			{
				"from": "out",
				"to": "out",
				"filter": [
					"**/*"
				]
			},
			"package.json",
			"NOTICE"
		],
		"asarUnpack": [
			"node_modules/better-sqlite3/**/*",
			"node_modules/node-pty/**/*",
			"node_modules/@parcel/watcher-win32-x64/**/*",
			"node_modules/@parcel/watcher-darwin-arm64/**/*",
			"node_modules/@parcel/watcher-darwin-x64/**/*"
		],
		"afterSign": "scripts/notarize.cjs",
		"afterAllArtifactBuild": "scripts/fix-artifacts.cjs",
		"extraResources": [
			{
				"from": "cli/qf.mjs",
				"to": "qf.mjs"
			},
			{
				"from": "packages/collab-canvas-skill",
				"to": "collab-canvas-skill"
			}
		],
		"mac": {
			"category": "public.app-category.productivity",
			"hardenedRuntime": true,
			"gatekeeperAssess": false,
			"notarize": false,
			"entitlements": "build/entitlements.mac.plist",
			"entitlementsInherit": "build/entitlements.mac.plist",
			"artifactName": "${productName}-${version}-${arch}-mac.${ext}",
			"extendInfo": {
				"NSMicrophoneUsageDescription": "QuantFlow needs microphone access to enable voice input for CLI tools like Claude Code."
			},
			"extraResources": [
				{
					"from": "vendor/tmux/tmux",
					"to": "tmux"
				},
				{
					"from": "vendor/tmux/lib",
					"to": "lib"
				},
				{
					"from": "resources/tmux.conf",
					"to": "tmux.conf"
				},
				{
					"from": "resources/terminfo",
					"to": "terminfo"
				}
			],
			"target": [
				{
					"target": "zip",
					"arch": [
						"arm64",
						"x64"
					]
				}
			]
		},
		"win": {
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64",
						"arm64"
					]
				}
			]
		},
		"nsis": {
			"oneClick": false,
			"perMachine": false,
			"allowElevation": true,
			"allowToChangeInstallationDirectory": true
		},
		"linux": {
			"category": "Development",
			"target": [
				{
					"target": "AppImage",
					"arch": "x64"
				}
			]
		}
	},
	"dependencies": {
		"@agentclientprotocol/claude-agent-acp": "^0.26.0",
		"@agentclientprotocol/sdk": "^0.18.2",
		"@assistant-ui/react": "^0.12.24",
		"@assistant-ui/react-markdown": "^0.12.8",
		"@blocknote/core": "0.47.0",
		"@blocknote/mantine": "0.47.0",
		"@blocknote/react": "0.47.0",
		"@lezer/common": "^1.5.1",
		"@lezer/python": "^1.1.18",
		"@parcel/watcher": "2.5.6",
		"@phosphor-icons/react": "2.1.7",
		"@posthog/react": "^1.8.2",
		"@postlight/parser": "^2.2.3",
		"@tiptap/core": "3.20.0",
		"@tiptap/extension-typography": "3.20.0",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/addon-unicode11": "^0.9.0",
		"@xterm/addon-webgl": "^0.19.0",
		"@xterm/xterm": "^6.0.0",
		"better-sqlite3": "^12.9.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "2.1.1",
		"d3": "7.9.0",
		"dependency-cruiser": "^17.3.8",
		"electron-log": "5.4.3",
		"electron-updater": "6.8.3",
		"front-matter": "4.0.2",
		"ignore": "7.0.5",
		"katex": "0.16.33",
		"lucide-react": "0.576.0",
		"monaco-editor": "^0.55.1",
		"node-pty": "^1.1.0",
		"posthog-js": "^1.359.1",
		"posthog-node": "^5.28.0",
		"react-markdown": "10.1.0",
		"rehype-katex": "7.0.1",
		"rehype-raw": "7.0.0",
		"remark-breaks": "4.0.0",
		"remark-gfm": "4.0.1",
		"remark-math": "6.0.0",
		"sharp": "0.34.5",
		"streamdown": "2.3.0",
		"tailwind-merge": "3.5.0",
		"typescript": "5.9.3",
		"use-stick-to-bottom": "1.1.3"
	},
	"overrides": {
		"@tiptap/core": "3.20.0",
		"@tiptap/extensions": "3.20.0",
		"@tiptap/extension-bold": "3.20.0",
		"@tiptap/extension-bubble-menu": "3.20.0",
		"@tiptap/extension-code": "3.20.0",
		"@tiptap/extension-floating-menu": "3.20.0",
		"@tiptap/extension-horizontal-rule": "3.20.0",
		"@tiptap/extension-italic": "3.20.0",
		"@tiptap/extension-link": "3.20.0",
		"@tiptap/extension-paragraph": "3.20.0",
		"@tiptap/react": "3.20.0",
		"@tiptap/pm": "3.20.0",
		"@tiptap/extension-strike": "3.20.0",
		"@tiptap/extension-text": "3.20.0",
		"@tiptap/extension-underline": "3.20.0",
		"@tiptap/extension-typography": "3.20.0"
	},
	"optionalDependencies": {
		"@img/sharp-darwin-arm64": "0.34.5",
		"@img/sharp-darwin-x64": "0.34.5",
		"@img/sharp-libvips-darwin-arm64": "1.2.4",
		"@img/sharp-libvips-darwin-x64": "1.2.4",
		"@img/sharp-libvips-linux-x64": "1.2.4",
		"@img/sharp-linux-x64": "0.34.5",
		"@parcel/watcher-darwin-arm64": "2.5.6",
		"@parcel/watcher-darwin-x64": "2.5.6"
	},
	"devDependencies": {
		"@electron/notarize": "2.5.0",
		"@electron/rebuild": "^4.0.3",
		"@octokit/rest": "22.0.1",
		"@tailwindcss/vite": "4.2.0",
		"@types/better-sqlite3": "^7.6.13",
		"@types/d3": "7.4.3",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.1.4",
		"app-builder-bin": "4.2.0",
		"electron": "40.6.0",
		"electron-builder": "26.8.1",
		"electron-vite": "5.0.0",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"tailwindcss": "4.2.0",
		"to-ico": "^1.1.5",
		"tsx": "^4.20.3"
	}
}
